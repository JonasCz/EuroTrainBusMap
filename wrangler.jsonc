{
  // Static-assets-only Worker: no script, so requests for static files never invoke code (free and unlimited).
  // The same dist/site directory can be hosted on any static host.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eurotrainbusmap",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/site",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "trains.jonas.bike", "custom_domain": true }],
  // the workers.dev address is switched off on deploy
  "workers_dev": false
  // To serve under a path instead, use e.g. { "pattern": "example.com/transit/*", "zone_name": "example.com" }
  // and build with BASE_PATH=/transit/
}
