{
  "name": "@etbm/etl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build-data": "NODE_USE_ENV_PROXY=1 node --no-warnings --max-old-space-size=8192 --expose-gc --import tsx src/cli.ts",
    "generate": "NODE_USE_ENV_PROXY=1 node --no-warnings --import tsx src/generators/cli.ts",
    "rail:refresh": "NODE_USE_ENV_PROXY=1 node --no-warnings --max-old-space-size=4096 --import tsx src/geometry/refresh-rail.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "assets": "NODE_USE_ENV_PROXY=1 node --no-warnings --max-old-space-size=8192 --import tsx src/assets.ts",
    "assets-version": "node --no-warnings --import tsx src/assets-version.ts",
    "stops:candidates": "NODE_USE_ENV_PROXY=1 node --no-warnings --max-old-space-size=8192 --import tsx src/stop-candidates.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@etbm/shared": "workspace:*",
    "geojson-vt": "^4.0.3",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
