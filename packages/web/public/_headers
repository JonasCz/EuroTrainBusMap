# Cloudflare static-asset caching (Workers/Pages `_headers`).
# Hashed bundles and build-versioned data never change; only data/manifest.json moves.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/data/:build/*
  Cache-Control: public, max-age=31536000, immutable
/glyphs/*
  Cache-Control: public, max-age=604800
